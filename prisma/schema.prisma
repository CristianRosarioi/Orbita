// Schema de Prisma para Órbita RD — Fase 3
// Prisma 7: la URL de conexión está en prisma.config.ts, NO aquí

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS — Fase 1
// ============================================================

enum Industria {
  RESTAURANTE
  COLMADO
  COLMADO_GRANDE
  CARWASH
  REPUESTOS
  TALLER_MECANICO
  FERRETERIA
  SALON_BARBERIA
  CLINICA
  DENTAL
  VETERINARIA
  INMOBILIARIA
  FARMACIA
  TIENDA_ROPA
  TIENDA_ONLINE
  JOYERIA
  SUPERMERCADO
  MINIMARKET
  OTRO

  @@map("industria")
}

enum ModoFiscal {
  SIMPLE
  FISCAL

  @@map("modo_fiscal")
}

enum RolEmpresa {
  OWNER
  ADMIN
  VENDEDOR
  CONTADOR
  CAJERO
  VIEWER

  @@map("rol_empresa")
}

enum EstadoSuscripcion {
  TRIAL
  ACTIVA
  SUSPENDIDA
  CANCELADA

  @@map("estado_suscripcion")
}

enum PlanSuscripcion {
  BASICO
  PRO
  EMPRESA

  @@map("plan_suscripcion")
}

// ============================================================
// ENUMS — Fase 2
// ============================================================

enum TipoProducto {
  BIEN     // Producto físico con inventario
  SERVICIO // Servicio sin inventario

  @@map("tipo_producto")
}

enum TipoCliente {
  PERSONA
  EMPRESA

  @@map("tipo_cliente")
}

enum TipoIdentificacion {
  CEDULA
  RNC
  PASAPORTE
  SIN_IDENTIFICACION

  @@map("tipo_identificacion")
}

enum NivelPrecio {
  CONTADO
  CREDITO
  MAYORISTA
  ESPECIAL

  @@map("nivel_precio")
}

// ============================================================
// MODELO: Usuario
// ============================================================
model Usuario {
  id        String    @id @default(cuid())
  clerkId   String    @unique @map("clerk_id")
  email     String    @unique
  nombre    String?
  apellido  String?
  avatar    String?
  telefono  String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  membresias   MiembroEmpresa[]
  sesionActual SesionUsuarioEmpresa?

  @@index([clerkId])
  @@index([email])
  @@index([deletedAt])
  @@map("usuarios")
}

// ============================================================
// MODELO: Empresa
// ============================================================
model Empresa {
  id              String            @id @default(cuid())
  nombre          String
  nombreComercial String?           @map("nombre_comercial")
  rnc             String?
  industria       Industria
  modoFiscal      ModoFiscal        @default(SIMPLE) @map("modo_fiscal")
  direccion       String?
  telefono        String?
  email           String?
  logoUrl         String?           @map("logo_url")
  moneda          String            @default("DOP")
  timezone        String            @default("America/Santo_Domingo")
  planSuscripcion PlanSuscripcion   @default(BASICO) @map("plan_suscripcion")
  estadoSusc      EstadoSuscripcion @default(TRIAL) @map("estado_suscripcion")
  trialFinaliza   DateTime?         @map("trial_finaliza")
  onboardingOculto Boolean          @default(false) @map("onboarding_oculto")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  miembros        MiembroEmpresa[]
  sucursales      Sucursal[]
  sesionesActivas SesionUsuarioEmpresa[]
  categorias      Categoria[]
  unidades        UnidadMedida[]
  clientes        Cliente[]
  proveedores     Proveedor[]
  productos       Producto[]
  secuencias      SecuenciaFactura[]
  facturas        Factura[]
  pagosFacturas   PagoFactura[]
  movimientos     MovimientoInventario[]
  cajas           SesionCaja[]
  cuentas         CuentaContable[]
  asientos        AsientoContable[]
  invitaciones    Invitacion[]
  mesas           Mesa[]
  comandas        Comanda[]
  cuentasFiado    CuentaFiado[]
  movimientosFiado MovimientoFiado[]
  ordenes         OrdenCompra[]
  gastos          Gasto[]
  empleados       Empleado[]
  nominas         Nomina[]
  ordenesTrabajo  OrdenTrabajo[]
  citas           Cita[]
  lotes            Lote[]
  pedidosProveedor PedidoProveedor[]
  stockSucursal    StockSucursal[]
  transferencias   TransferenciaInventario[]
  pacientes        Paciente[]
  consultas        Consulta[]
  departamentos      Departamento[]
  categoriasSuper    CategoriaSuper[]
  ofertas            Oferta[]
  preciosVolumen     PrecioVolumen[]
  configNotificacion ConfigNotificacion?
  notificaciones     Notificacion[]
  propiedades        Propiedad[]
  contratos          ContratoAlquiler[]
  pagosAlquiler      PagoAlquiler[]
  piezasJoya         PiezaJoya[]
  reparacionesJoya   ReparacionJoya[]
  ordenesCarwash     OrdenCarwash[]
  repuestos          Repuesto[]
  cotizaciones       Cotizacion[]
  variantes          Variante[]
  devoluciones       Devolucion[]
  pedidosOnline      PedidoOnline[]
  @@index([rnc])
  @@index([deletedAt])
  @@map("empresas")
}

// ============================================================
// MODELO: MiembroEmpresa
// ============================================================
model MiembroEmpresa {
  id          String     @id @default(cuid())
  usuarioId   String     @map("usuario_id")
  empresaId   String     @map("empresa_id")
  rol         RolEmpresa
  activo      Boolean    @default(true)
  invitadoPor String?    @map("invitado_por")
  aceptadoEn  DateTime?  @map("aceptado_en")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, empresaId])
  @@index([empresaId])
  @@index([usuarioId])
  @@map("miembros_empresa")
}

// ============================================================
// MODELO: Sucursal
// ============================================================
model Sucursal {
  id          String    @id @default(cuid())
  empresaId   String    @map("empresa_id")
  nombre      String
  codigo      String
  direccion   String?
  telefono    String?
  ciudad      String?
  encargado   String?
  esPrincipal Boolean   @default(false) @map("es_principal")
  activa      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  empresa                Empresa                  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sesionesActivas        SesionUsuarioEmpresa[]
  facturas               Factura[]
  sesionCaja             SesionCaja[]
  stockSucursal          StockSucursal[]
  transferenciasOrigen   TransferenciaInventario[] @relation("TransferenciaOrigen")
  transferenciasDestino  TransferenciaInventario[] @relation("TransferenciaDestino")
  movimientos            MovimientoInventario[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@index([empresaId, deletedAt])
  @@map("sucursales")
}

// ============================================================
// MODELO: SesionUsuarioEmpresa
// ============================================================
model SesionUsuarioEmpresa {
  id               String    @id @default(cuid())
  usuarioId        String    @unique @map("usuario_id")
  empresaActivaId  String    @map("empresa_activa_id")
  sucursalActivaId String?   @map("sucursal_activa_id")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  usuario        Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresaActiva  Empresa   @relation(fields: [empresaActivaId], references: [id])
  sucursalActiva Sucursal? @relation(fields: [sucursalActivaId], references: [id])

  @@index([empresaActivaId])
  @@map("sesiones_usuario_empresa")
}

// ============================================================
// MODELO: Categoria
// ============================================================
model Categoria {
  id          String    @id @default(cuid())
  empresaId   String    @map("empresa_id")
  nombre      String
  descripcion String?
  color       String?
  icono       String?
  orden       Int       @default(0)
  activa      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  productos Producto[]

  @@index([empresaId, deletedAt])
  @@map("categorias")
}

// ============================================================
// MODELO: UnidadMedida
// ============================================================
model UnidadMedida {
  id          String    @id @default(cuid())
  empresaId   String    @map("empresa_id")
  nombre      String
  abreviatura String
  esBase      Boolean   @default(false) @map("es_base")
  activa      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  productos Producto[]

  @@index([empresaId, deletedAt])
  @@map("unidades_medida")
}

// ============================================================
// MODELO: Cliente
// ============================================================
model Cliente {
  id                 String             @id @default(cuid())
  empresaId          String             @map("empresa_id")
  tipo               TipoCliente
  tipoIdentificacion TipoIdentificacion @default(SIN_IDENTIFICACION) @map("tipo_identificacion")
  identificacion     String?
  nombre             String
  nombreComercial    String?            @map("nombre_comercial")
  email              String?
  telefono           String?
  celular            String?
  direccion          String?
  ciudad             String?
  provincia          String?
  notas              String?
  limiteCredito      Decimal            @default(0) @map("limite_credito")
  diasCredito        Int                @default(0) @map("dias_credito")
  activo             Boolean            @default(true)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")

  empresa          Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  facturas         Factura[]
  cuentaFiado      CuentaFiado?
  ordenesTrabajo   OrdenTrabajo[]
  citas            Cita[]
  paciente         Paciente?
  contratos        ContratoAlquiler[]
  piezasJoya       PiezaJoya[]
  reparacionesJoya ReparacionJoya[]
  ordenesCarwash   OrdenCarwash[]
  cotizaciones     Cotizacion[]
  devoluciones     Devolucion[]
  pedidosOnline    PedidoOnline[]

  @@index([empresaId, deletedAt])
  @@index([empresaId, identificacion])
  @@index([empresaId, nombre])
  @@map("clientes")
}

// ============================================================
// MODELO: Proveedor
// ============================================================
model Proveedor {
  id                 String             @id @default(cuid())
  empresaId          String             @map("empresa_id")
  tipoIdentificacion TipoIdentificacion @default(RNC) @map("tipo_identificacion")
  identificacion     String?
  nombre             String
  nombreComercial    String?            @map("nombre_comercial")
  contacto           String?
  email              String?
  telefono           String?
  celular            String?
  direccion          String?
  ciudad             String?
  provincia          String?
  notas              String?
  diasCredito        Int                @default(0) @map("dias_credito")
  activo             Boolean            @default(true)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")

  empresa          Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  ordenesCompra    OrdenCompra[]
  gastos           Gasto[]
  pedidosProveedor PedidoProveedor[]

  @@index([empresaId, deletedAt])
  @@index([empresaId, identificacion])
  @@map("proveedores")
}

// ============================================================
// MODELO: Producto
// ============================================================
model Producto {
  id                    String       @id @default(cuid())
  empresaId             String       @map("empresa_id")
  tipo                  TipoProducto @default(BIEN)
  nombre                String
  descripcion           String?
  sku                   String?
  codigoBarras          String?      @map("codigo_barras")
  categoriaId           String?      @map("categoria_id")
  unidadMedidaId        String       @map("unidad_medida_id")
  precioVenta           Decimal      @map("precio_venta")
  precioCompra          Decimal      @default(0) @map("precio_compra")
  itbisAplicable        Boolean      @default(true) @map("itbis_aplicable")
  itbisIncluidoEnPrecio Boolean      @default(false) @map("itbis_incluido_en_precio")
  stockActual           Decimal      @default(0) @map("stock_actual")
  stockMinimo           Decimal      @default(0) @map("stock_minimo")
  imagenUrl             String?      @map("imagen_url")
  activo                Boolean      @default(true)
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  deletedAt             DateTime?    @map("deleted_at")

  empresa       Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  categoria     Categoria?       @relation(fields: [categoriaId], references: [id])
  unidadMedida  UnidadMedida     @relation(fields: [unidadMedidaId], references: [id])
  precios       PrecioProducto[]
  itemsFactura      ItemFactura[]
  movimientos       MovimientoInventario[]
  itemsComanda      ItemComanda[]
  itemsOrdenCompra     ItemOrdenCompra[]
  itemsOrdenTrabajo    ItemOrdenTrabajo[]
  lotes                Lote[]
  itemsPedidoProveedor ItemPedidoProveedor[]
  stockSucursal        StockSucursal[]
  transferencias       TransferenciaInventario[]
  ofertas              Oferta[]
  preciosVolumen       PrecioVolumen[]
  variantes            Variante[]
  itemsPedidoOnline    ItemPedidoOnline[]

  @@index([empresaId, deletedAt])
  @@index([empresaId, sku])
  @@index([empresaId, codigoBarras])
  @@index([empresaId, nombre])
  @@map("productos")
}

// ============================================================
// MODELO: PrecioProducto
// ============================================================
model PrecioProducto {
  id         String      @id @default(cuid())
  productoId String      @map("producto_id")
  nivel      NivelPrecio
  precio     Decimal
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([productoId, nivel])
  @@map("precios_producto")
}

// ============================================================
// ENUMS — Fase 3
// ============================================================

enum EstadoFactura {
  BORRADOR
  EMITIDA
  PAGADA
  ANULADA
  VENCIDA

  @@map("estado_factura")
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  CHEQUE
  CREDITO

  @@map("metodo_pago")
}

enum TipoMovimientoInventario {
  VENTA
  DEVOLUCION
  AJUSTE_ENTRADA
  AJUSTE_SALIDA
  COMPRA

  @@map("tipo_movimiento_inventario")
}

// ============================================================
// MODELO: SecuenciaFactura
// ============================================================
model SecuenciaFactura {
  id            String   @id @default(cuid())
  empresaId     String   @map("empresa_id")
  prefijo       String   @default("FAC")
  anio          Int
  ultimoNumero  Int      @default(0) @map("ultimo_numero")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, anio])
  @@index([empresaId])
  @@map("secuencias_factura")
}

// ============================================================
// MODELO: Factura
// ============================================================
model Factura {
  id                    String        @id @default(cuid())
  empresaId             String        @map("empresa_id")
  sucursalId            String?       @map("sucursal_id")
  numero                String        @map("numero")
  numeroInt             Int           @map("numero_int")
  anio                  Int
  clienteId             String?       @map("cliente_id")
  clienteNombre         String        @map("cliente_nombre")
  clienteIdentificacion String?       @map("cliente_identificacion")
  estado                EstadoFactura @default(BORRADOR)
  metodoPago            MetodoPago    @default(EFECTIVO) @map("metodo_pago")
  subtotal              Decimal
  itbis                 Decimal       @default(0)
  descuento             Decimal       @default(0)
  total                 Decimal
  totalPagado           Decimal       @default(0) @map("total_pagado")
  saldo                 Decimal
  notas                 String?
  fechaVencimiento      DateTime?     @map("fecha_vencimiento")
  fechaEmision          DateTime      @default(now()) @map("fecha_emision")
  creadoPor             String        @map("creado_por")
  anuladoPor            String?       @map("anulado_por")
  motivoAnulacion       String?       @map("motivo_anulacion")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  deletedAt             DateTime?     @map("deleted_at")

  sesionCajaId          String?       @map("sesion_caja_id")

  empresa     Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cliente     Cliente?              @relation(fields: [clienteId], references: [id])
  sucursal    Sucursal?             @relation(fields: [sucursalId], references: [id])
  sesionCaja  SesionCaja?           @relation(fields: [sesionCajaId], references: [id])
  items       ItemFactura[]
  pagos       PagoFactura[]
  movimientos MovimientoInventario[]
  consulta    Consulta?
  devoluciones Devolucion[]

  @@unique([empresaId, numero])
  @@index([empresaId, estado])
  @@index([empresaId, clienteId])
  @@index([empresaId, fechaEmision])
  @@index([empresaId, numeroInt])
  @@map("facturas")
}

// ============================================================
// MODELO: ItemFactura
// ============================================================
model ItemFactura {
  id              String  @id @default(cuid())
  facturaId       String  @map("factura_id")
  productoId      String? @map("producto_id")
  productoNombre  String  @map("producto_nombre")
  productoSku     String? @map("producto_sku")
  cantidad        Decimal
  precioUnitario  Decimal @map("precio_unitario")
  itbisPorcentaje Decimal @default(18) @map("itbis_porcentaje")
  itbisMonto      Decimal @default(0) @map("itbis_monto")
  descuento       Decimal @default(0)
  subtotal        Decimal
  total           Decimal
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  factura  Factura   @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  producto Producto? @relation(fields: [productoId], references: [id])

  @@index([facturaId])
  @@index([productoId])
  @@map("items_factura")
}

// ============================================================
// MODELO: PagoFactura
// ============================================================
model PagoFactura {
  id            String     @id @default(cuid())
  facturaId     String     @map("factura_id")
  empresaId     String     @map("empresa_id")
  monto         Decimal
  metodoPago    MetodoPago @map("metodo_pago")
  referencia    String?
  notas         String?
  fechaPago     DateTime   @default(now()) @map("fecha_pago")
  registradoPor String     @map("registrado_por")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  factura Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([facturaId])
  @@index([empresaId, fechaPago])
  @@map("pagos_factura")
}

// ============================================================
// ENUMS — Fase 4
// ============================================================

enum EstadoCaja {
  ABIERTA
  CERRADA

  @@map("estado_caja")
}

// ============================================================
// MODELO: SesionCaja
// ============================================================
model SesionCaja {
  id                    String      @id @default(cuid())
  empresaId             String      @map("empresa_id")
  sucursalId            String?     @map("sucursal_id")
  usuarioId             String      @map("usuario_id")
  estado                EstadoCaja  @default(ABIERTA)
  montoApertura         Decimal     @map("monto_apertura")
  montoCierreDeclarado  Decimal?    @map("monto_cierre_declarado")
  montoCierreReal       Decimal?    @map("monto_cierre_real")
  diferencia            Decimal?
  fechaApertura         DateTime    @default(now()) @map("fecha_apertura")
  fechaCierre           DateTime?   @map("fecha_cierre")
  notas                 String?
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  empresa  Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sucursal Sucursal? @relation(fields: [sucursalId], references: [id])
  facturas Factura[]

  @@index([empresaId, estado])
  @@index([empresaId, fechaApertura])
  @@map("sesiones_caja")
}

// ============================================================
// MODELO: MovimientoInventario
// ============================================================
model MovimientoInventario {
  id            String                   @id @default(cuid())
  empresaId     String                   @map("empresa_id")
  productoId    String                   @map("producto_id")
  facturaId     String?                  @map("factura_id")
  sucursalId    String?                  @map("sucursal_id")
  tipo          TipoMovimientoInventario
  cantidad      Decimal
  stockAntes    Decimal                  @map("stock_antes")
  stockDespues  Decimal                  @map("stock_despues")
  notas         String?
  creadoPor     String                   @map("creado_por")
  createdAt     DateTime                 @default(now()) @map("created_at")

  ordenCompraId String?  @map("orden_compra_id")

  empresa     Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  producto    Producto     @relation(fields: [productoId], references: [id])
  factura     Factura?     @relation(fields: [facturaId], references: [id])
  sucursal    Sucursal?    @relation(fields: [sucursalId], references: [id])
  ordenCompra OrdenCompra? @relation(fields: [ordenCompraId], references: [id])

  @@index([empresaId, productoId])
  @@index([facturaId])
  @@index([sucursalId])
  @@index([ordenCompraId])
  @@map("movimientos_inventario")
}

// ============================================================
// ENUMS — Fase 6
// ============================================================

enum EstadoInvitacion {
  PENDIENTE
  ACEPTADA
  RECHAZADA
  EXPIRADA

  @@map("estado_invitacion")
}

// ============================================================
// MODELO: Invitacion
// ============================================================
model Invitacion {
  id          String           @id @default(cuid())
  empresaId   String           @map("empresa_id")
  email       String
  rol         RolEmpresa
  token       String           @unique
  estado      EstadoInvitacion @default(PENDIENTE)
  invitadoPor String           @map("invitado_por")
  expiresAt   DateTime         @map("expires_at")
  aceptadoEn  DateTime?        @map("aceptado_en")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@index([token])
  @@index([email])
  @@map("invitaciones")
}

