// Schema de Prisma para Órbita RD — Fase 2
// Prisma 7: la URL de conexión está en prisma.config.ts, NO aquí

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS — Fase 1
// ============================================================

enum Industria {
  RESTAURANTE
  COLMADO
  CARWASH
  REPUESTOS
  TALLER_MECANICO
  FERRETERIA
  SALON_BARBERIA
  CLINICA
  INMOBILIARIA
  FARMACIA
  TIENDA_ROPA
  TIENDA_ONLINE
  JOYERIA
  OTRO

  @@map("industria")
}

enum ModoFiscal {
  SIMPLE
  FISCAL

  @@map("modo_fiscal")
}

enum RolEmpresa {
  OWNER
  ADMIN
  VENDEDOR
  CONTADOR
  CAJERO
  VIEWER

  @@map("rol_empresa")
}

enum EstadoSuscripcion {
  TRIAL
  ACTIVA
  SUSPENDIDA
  CANCELADA

  @@map("estado_suscripcion")
}

enum PlanSuscripcion {
  BASICO
  PRO
  EMPRESA

  @@map("plan_suscripcion")
}

// ============================================================
// ENUMS — Fase 2
// ============================================================

enum TipoProducto {
  BIEN     // Producto físico con inventario
  SERVICIO // Servicio sin inventario

  @@map("tipo_producto")
}

enum TipoCliente {
  PERSONA
  EMPRESA

  @@map("tipo_cliente")
}

enum TipoIdentificacion {
  CEDULA
  RNC
  PASAPORTE
  SIN_IDENTIFICACION

  @@map("tipo_identificacion")
}

enum NivelPrecio {
  CONTADO
  CREDITO
  MAYORISTA
  ESPECIAL

  @@map("nivel_precio")
}

// ============================================================
// MODELO: Usuario
// ============================================================
model Usuario {
  id        String    @id @default(cuid())
  clerkId   String    @unique @map("clerk_id")
  email     String    @unique
  nombre    String?
  apellido  String?
  avatar    String?
  telefono  String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  membresias   MiembroEmpresa[]
  sesionActual SesionUsuarioEmpresa?

  @@index([clerkId])
  @@index([email])
  @@index([deletedAt])
  @@map("usuarios")
}

// ============================================================
// MODELO: Empresa
// ============================================================
model Empresa {
  id              String            @id @default(cuid())
  nombre          String
  nombreComercial String?           @map("nombre_comercial")
  rnc             String?
  industria       Industria
  modoFiscal      ModoFiscal        @default(SIMPLE) @map("modo_fiscal")
  direccion       String?
  telefono        String?
  email           String?
  logoUrl         String?           @map("logo_url")
  moneda          String            @default("DOP")
  timezone        String            @default("America/Santo_Domingo")
  planSuscripcion PlanSuscripcion   @default(BASICO) @map("plan_suscripcion")
  estadoSusc      EstadoSuscripcion @default(TRIAL) @map("estado_suscripcion")
  trialFinaliza   DateTime?         @map("trial_finaliza")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  miembros        MiembroEmpresa[]
  sucursales      Sucursal[]
  sesionesActivas SesionUsuarioEmpresa[]
  categorias      Categoria[]
  unidades        UnidadMedida[]
  clientes        Cliente[]
  proveedores     Proveedor[]
  productos       Producto[]

  @@index([rnc])
  @@index([deletedAt])
  @@map("empresas")
}

// ============================================================
// MODELO: MiembroEmpresa
// ============================================================
model MiembroEmpresa {
  id          String     @id @default(cuid())
  usuarioId   String     @map("usuario_id")
  empresaId   String     @map("empresa_id")
  rol         RolEmpresa
  activo      Boolean    @default(true)
  invitadoPor String?    @map("invitado_por")
  aceptadoEn  DateTime?  @map("aceptado_en")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, empresaId])
  @@index([empresaId])
  @@index([usuarioId])
  @@map("miembros_empresa")
}

// ============================================================
// MODELO: Sucursal
// ============================================================
model Sucursal {
  id          String    @id @default(cuid())
  empresaId   String    @map("empresa_id")
  nombre      String
  codigo      String
  direccion   String?
  telefono    String?
  esPrincipal Boolean   @default(false) @map("es_principal")
  activa      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  empresa         Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sesionesActivas SesionUsuarioEmpresa[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@index([empresaId, deletedAt])
  @@map("sucursales")
}

// ============================================================
// MODELO: SesionUsuarioEmpresa
// ============================================================
model SesionUsuarioEmpresa {
  id               String    @id @default(cuid())
  usuarioId        String    @unique @map("usuario_id")
  empresaActivaId  String    @map("empresa_activa_id")
  sucursalActivaId String?   @map("sucursal_activa_id")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  usuario        Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresaActiva  Empresa   @relation(fields: [empresaActivaId], references: [id])
  sucursalActiva Sucursal? @relation(fields: [sucursalActivaId], references: [id])

  @@index([empresaActivaId])
  @@map("sesiones_usuario_empresa")
}

// ============================================================
// MODELO: Categoria
// ============================================================
model Categoria {
  id          String    @id @default(cuid())
  empresaId   String    @map("empresa_id")
  nombre      String
  descripcion String?
  color       String?
  icono       String?
  orden       Int       @default(0)
  activa      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  productos Producto[]

  @@index([empresaId, deletedAt])
  @@map("categorias")
}

// ============================================================
// MODELO: UnidadMedida
// ============================================================
model UnidadMedida {
  id          String    @id @default(cuid())
  empresaId   String    @map("empresa_id")
  nombre      String
  abreviatura String
  esBase      Boolean   @default(false) @map("es_base")
  activa      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  productos Producto[]

  @@index([empresaId, deletedAt])
  @@map("unidades_medida")
}

// ============================================================
// MODELO: Cliente
// ============================================================
model Cliente {
  id                 String             @id @default(cuid())
  empresaId          String             @map("empresa_id")
  tipo               TipoCliente
  tipoIdentificacion TipoIdentificacion @default(SIN_IDENTIFICACION) @map("tipo_identificacion")
  identificacion     String?
  nombre             String
  nombreComercial    String?            @map("nombre_comercial")
  email              String?
  telefono           String?
  celular            String?
  direccion          String?
  ciudad             String?
  provincia          String?
  notas              String?
  limiteCredito      Decimal            @default(0) @map("limite_credito")
  diasCredito        Int                @default(0) @map("dias_credito")
  activo             Boolean            @default(true)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId, deletedAt])
  @@index([empresaId, identificacion])
  @@index([empresaId, nombre])
  @@map("clientes")
}

// ============================================================
// MODELO: Proveedor
// ============================================================
model Proveedor {
  id                 String             @id @default(cuid())
  empresaId          String             @map("empresa_id")
  tipoIdentificacion TipoIdentificacion @default(RNC) @map("tipo_identificacion")
  identificacion     String?
  nombre             String
  nombreComercial    String?            @map("nombre_comercial")
  contacto           String?
  email              String?
  telefono           String?
  celular            String?
  direccion          String?
  ciudad             String?
  provincia          String?
  notas              String?
  diasCredito        Int                @default(0) @map("dias_credito")
  activo             Boolean            @default(true)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId, deletedAt])
  @@index([empresaId, identificacion])
  @@map("proveedores")
}

// ============================================================
// MODELO: Producto
// ============================================================
model Producto {
  id                    String       @id @default(cuid())
  empresaId             String       @map("empresa_id")
  tipo                  TipoProducto @default(BIEN)
  nombre                String
  descripcion           String?
  sku                   String?
  codigoBarras          String?      @map("codigo_barras")
  categoriaId           String?      @map("categoria_id")
  unidadMedidaId        String       @map("unidad_medida_id")
  precioVenta           Decimal      @map("precio_venta")
  precioCompra          Decimal      @default(0) @map("precio_compra")
  itbisAplicable        Boolean      @default(true) @map("itbis_aplicable")
  itbisIncluidoEnPrecio Boolean      @default(false) @map("itbis_incluido_en_precio")
  stockActual           Decimal      @default(0) @map("stock_actual")
  stockMinimo           Decimal      @default(0) @map("stock_minimo")
  imagenUrl             String?      @map("imagen_url")
  activo                Boolean      @default(true)
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  deletedAt             DateTime?    @map("deleted_at")

  empresa      Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  categoria    Categoria?     @relation(fields: [categoriaId], references: [id])
  unidadMedida UnidadMedida   @relation(fields: [unidadMedidaId], references: [id])
  precios      PrecioProducto[]

  @@index([empresaId, deletedAt])
  @@index([empresaId, sku])
  @@index([empresaId, codigoBarras])
  @@index([empresaId, nombre])
  @@map("productos")
}

// ============================================================
// MODELO: PrecioProducto
// ============================================================
model PrecioProducto {
  id         String      @id @default(cuid())
  productoId String      @map("producto_id")
  nivel      NivelPrecio
  precio     Decimal
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([productoId, nivel])
  @@map("precios_producto")
}
